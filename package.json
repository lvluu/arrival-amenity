{
  "name": "arrival-fruit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun build src/app.ts src/sw.ts --outdir public --target browser --minify && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/",
    "dev": "bun run build && wrangler dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "deploy": "bun run build && wrangler deploy"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
