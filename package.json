{
  "name": "arrival-amenity",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun run build && wrangler dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "deploy": "bun run build && wrangler deploy"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.4.4",
    "jszip": "3.10.1",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
